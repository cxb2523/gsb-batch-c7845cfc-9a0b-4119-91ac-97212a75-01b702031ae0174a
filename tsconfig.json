{
  "compilerOptions": {
    "target": "ES2022",                 // Node 18 fully supports ES2022 features
    "module": "NodeNext",               // Emits ESM because package.json has "type": "module"
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": true,
    "removeComments": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
