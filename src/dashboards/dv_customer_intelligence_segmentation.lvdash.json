{
  "datasets": [
    {
      "name": "negative_reviews",
      "displayName": "Recent Negative Reviews",
      "queryLines": [
        "SELECT\n",
        "  review_id,\n",
        "  restaurant_name,\n",
        "  rating,\n",
        "  sentiment,\n",
        "  review_text,\n",
        "  review_date,\n",
        "  issue_delivery,\n",
        "  issue_delivery_reason,\n",
        "  issue_food_quality,\n",
        "  issue_food_quality_reason,\n",
        "  issue_pricing,\n",
        "  issue_pricing_reason,\n",
        "  issue_portion_size,\n",
        "  issue_portion_size_reason\n",
        "FROM\n",
        "  restaurant_chain_db.marts.fact_review\n",
        "WHERE\n",
        "  sentiment = 'negative'\n",
        "ORDER BY\n",
        "  review_date DESC"
      ]
    },
    {
      "name": "issue_types",
      "displayName": "Issue Type Distribution",
      "queryLines": [
        "SELECT\n",
        "  'Delivery' as issue_type,\n",
        "  SUM(\n",
        "    CASE\n",
        "      WHEN issue_delivery = 'true' THEN 1\n",
        "      ELSE 0\n",
        "    END\n",
        "  ) as issue_count\n",
        "FROM\n",
        "  restaurant_chain_db.marts.fact_review\n",
        "UNION ALL\n",
        "SELECT\n",
        "  'Food Quality',\n",
        "  SUM(\n",
        "    CASE\n",
        "      WHEN issue_food_quality = 'true' THEN 1\n",
        "      ELSE 0\n",
        "    END\n",
        "  )\n",
        "FROM\n",
        "  restaurant_chain_db.marts.fact_review\n",
        "UNION ALL\n",
        "SELECT\n",
        "  'Pricing',\n",
        "  SUM(\n",
        "    CASE\n",
        "      WHEN issue_pricing = 'true' THEN 1\n",
        "      ELSE 0\n",
        "    END\n",
        "  )\n",
        "FROM\n",
        "  restaurant_chain_db.marts.fact_review\n",
        "UNION ALL\n",
        "SELECT\n",
        "  'Portion Size',\n",
        "  SUM(\n",
        "    CASE\n",
        "      WHEN issue_portion_size = 'true' THEN 1\n",
        "      ELSE 0\n",
        "    END\n",
        "  )\n",
        "FROM\n",
        "  restaurant_chain_db.marts.fact_review"
      ]
    },
    {
      "name": "issue_tracking",
      "displayName": "Issue Tracking by Restaurant",
      "queryLines": [
        "SELECT\n",
        "  restaurant_name,\n",
        "  'Delivery' as issue_type,\n",
        "  SUM(\n",
        "    CASE\n",
        "      WHEN issue_delivery = 'true' THEN 1\n",
        "      ELSE 0\n",
        "    END\n",
        "  ) as issue_count\n",
        "FROM\n",
        "  restaurant_chain_db.marts.fact_review\n",
        "GROUP BY\n",
        "  restaurant_name\n",
        "UNION ALL\n",
        "SELECT\n",
        "  restaurant_name,\n",
        "  'Food Quality',\n",
        "  SUM(\n",
        "    CASE\n",
        "      WHEN issue_food_quality = 'true' THEN 1\n",
        "      ELSE 0\n",
        "    END\n",
        "  )\n",
        "FROM\n",
        "  restaurant_chain_db.marts.fact_review\n",
        "GROUP BY\n",
        "  restaurant_name\n",
        "UNION ALL\n",
        "SELECT\n",
        "  restaurant_name,\n",
        "  'Pricing',\n",
        "  SUM(\n",
        "    CASE\n",
        "      WHEN issue_pricing = 'true' THEN 1\n",
        "      ELSE 0\n",
        "    END\n",
        "  )\n",
        "FROM\n",
        "  restaurant_chain_db.marts.fact_review\n",
        "GROUP BY\n",
        "  restaurant_name\n",
        "UNION ALL\n",
        "SELECT\n",
        "  restaurant_name,\n",
        "  'Portion Size',\n",
        "  SUM(\n",
        "    CASE\n",
        "      WHEN issue_portion_size = 'true' THEN 1\n",
        "      ELSE 0\n",
        "    END\n",
        "  )\n",
        "FROM\n",
        "  restaurant_chain_db.marts.fact_review\n",
        "GROUP BY\n",
        "  restaurant_name"
      ]
    },
    {
      "name": "sentiment_mv",
      "displayName": "sentiment_metrics",
      "asset_name": "restaurant_chain_db.marts.sentiment_metrics"
    },
    {
      "name": "review_by_rest",
      "displayName": "Review Detail by Restaurant",
      "queryLines": [
        "SELECT\n",
        "  restaurant_name,\n",
        "  restaurant_city,\n",
        "  COUNT(*) as total_reviews,\n",
        "  ROUND(AVG(rating), 2) as avg_rating,\n",
        "  ROUND(\n",
        "    SUM(\n",
        "      CASE\n",
        "        WHEN sentiment = 'positive' THEN 1\n",
        "        ELSE 0\n",
        "      END\n",
        "    )\n",
        "      * 100.0\n",
        "      / COUNT(*),\n",
        "    1\n",
        "  ) as positive_pct,\n",
        "  ROUND(\n",
        "    SUM(\n",
        "      CASE\n",
        "        WHEN sentiment = 'negative' THEN 1\n",
        "        ELSE 0\n",
        "      END\n",
        "    )\n",
        "      * 100.0\n",
        "      / COUNT(*),\n",
        "    1\n",
        "  ) as negative_pct,\n",
        "  ROUND(\n",
        "    SUM(\n",
        "      CASE\n",
        "        WHEN sentiment = 'neutral' THEN 1\n",
        "        ELSE 0\n",
        "      END\n",
        "    )\n",
        "      * 100.0\n",
        "      / COUNT(*),\n",
        "    1\n",
        "  ) as neutral_pct\n",
        "FROM\n",
        "  restaurant_chain_db.marts.fact_review\n",
        "GROUP BY\n",
        "  restaurant_name,\n",
        "  restaurant_city"
      ]
    },
    {
      "name": "sentiment_dist",
      "displayName": "Sentiment Distribution",
      "queryLines": [
        "SELECT\n",
        "  sentiment,\n",
        "  COUNT(*) as review_count\n",
        "FROM\n",
        "  restaurant_chain_db.marts.fact_review\n",
        "WHERE\n",
        "  sentiment IS NOT NULL\n",
        "GROUP BY\n",
        "  sentiment"
      ]
    },
    {
      "name": "customer_mv",
      "displayName": "customer_lifecycle_metrics",
      "asset_name": "restaurant_chain_db.marts.customer_lifecycle_metrics"
    },
    {
      "name": "sentiment_by_rating",
      "displayName": "Sentiment by Rating",
      "queryLines": [
        "SELECT\n",
        "  rating,\n",
        "  sentiment,\n",
        "  COUNT(*) as review_count\n",
        "FROM\n",
        "  restaurant_chain_db.marts.fact_review\n",
        "WHERE\n",
        "  sentiment IS NOT NULL\n",
        "GROUP BY\n",
        "  rating,\n",
        "  sentiment\n",
        "ORDER BY\n",
        "  rating"
      ]
    }
  ],
