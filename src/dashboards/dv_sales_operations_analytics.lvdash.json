{
  "datasets": [
    {
      "name": "sales_ops_mv",
      "displayName": "sales_operations_metrics",
      "asset_name": "restaurant_chain_db.marts.sales_operations_metrics"
    },
    {
      "name": "payment_trend",
      "displayName": "Payment Method Trend",
      "queryLines": [
        "SELECT\n",
        "  order_month,\n",
        "  'Card' as method,\n",
        "  SUM(card_orders) as orders\n",
        "FROM\n",
        "  restaurant_chain_db.marts.agg_restaurant_performance_daily\n",
        "GROUP BY\n",
        "  order_month\n",
        "UNION ALL\n",
        "SELECT\n",
        "  order_month,\n",
        "  'Cash',\n",
        "  SUM(cash_orders)\n",
        "FROM\n",
        "  restaurant_chain_db.marts.agg_restaurant_performance_daily\n",
        "GROUP BY\n",
        "  order_month\n",
        "UNION ALL\n",
        "SELECT\n",
        "  order_month,\n",
        "  'Wallet',\n",
        "  SUM(wallet_orders)\n",
        "FROM\n",
        "  restaurant_chain_db.marts.agg_restaurant_performance_daily\n",
        "GROUP BY\n",
        "  order_month\n",
        "ORDER BY\n",
        "  order_month"
      ]
    },
    {
      "name": "payment_mix_rest",
      "displayName": "Payment Mix by Restaurant",
      "queryLines": [
        "SELECT\n",
        "  restaurant_name,\n",
        "  'Card' as method,\n",
        "  ROUND(SUM(card_orders) * 100.0 / SUM(total_orders), 1) as mix_pct\n",
        "FROM\n",
        "  restaurant_chain_db.marts.agg_restaurant_performance_daily\n",
        "GROUP BY\n",
        "  restaurant_name\n",
        "UNION ALL\n",
        "SELECT\n",
        "  restaurant_name,\n",
        "  'Cash',\n",
        "  ROUND(SUM(cash_orders) * 100.0 / SUM(total_orders), 1)\n",
        "FROM\n",
        "  restaurant_chain_db.marts.agg_restaurant_performance_daily\n",
        "GROUP BY\n",
        "  restaurant_name\n",
        "UNION ALL\n",
        "SELECT\n",
        "  restaurant_name,\n",
        "  'Wallet',\n",
        "  ROUND(SUM(wallet_orders) * 100.0 / SUM(total_orders), 1)\n",
        "FROM\n",
        "  restaurant_chain_db.marts.agg_restaurant_performance_daily\n",
        "GROUP BY\n",
        "  restaurant_name"
      ]
    },
    {
      "name": "digital_trend",
      "displayName": "Digital Payment Trend",
      "queryLines": [
        "SELECT\n",
        "  order_month,\n",
        "  ROUND((SUM(card_orders) + SUM(wallet_orders)) * 100.0 / SUM(total_orders), 1) as digital_pct\n",
        "FROM\n",
        "  restaurant_chain_db.marts.agg_restaurant_performance_daily\n",
        "GROUP BY\n",
        "  order_month\n",
        "ORDER BY\n",
        "  order_month"
      ]
    },
    {
      "name": "channel_mix_rest",
      "displayName": "Channel Mix by Restaurant",
      "queryLines": [
        "SELECT\n",
        "  restaurant_name,\n",
        "  'Dine-In' as channel,\n",
        "  ROUND(SUM(dine_in_orders) * 100.0 / SUM(total_orders), 1) as mix_pct\n",
        "FROM\n",
        "  restaurant_chain_db.marts.agg_restaurant_performance_daily\n",
        "GROUP BY\n",
        "  restaurant_name\n",
        "UNION ALL\n",
        "SELECT\n",
        "  restaurant_name,\n",
        "  'Takeaway',\n",
        "  ROUND(SUM(takeaway_orders) * 100.0 / SUM(total_orders), 1)\n",
        "FROM\n",
        "  restaurant_chain_db.marts.agg_restaurant_performance_daily\n",
        "GROUP BY\n",
        "  restaurant_name\n",
        "UNION ALL\n",
        "SELECT\n",
        "  restaurant_name,\n",
        "  'Delivery',\n",
        "  ROUND(SUM(delivery_orders) * 100.0 / SUM(total_orders), 1)\n",
        "FROM\n",
        "  restaurant_chain_db.marts.agg_restaurant_performance_daily\n",
        "GROUP BY\n",
        "  restaurant_name"
      ]
    },
    {
      "name": "orders_by_rest_channel",
      "displayName": "Orders by Restaurant & Channel",
      "queryLines": [
        "SELECT\n",
        "  restaurant_name,\n",
        "  'Dine-In' as channel,\n",
        "  SUM(dine_in_orders) as orders\n",
        "FROM\n",
        "  restaurant_chain_db.marts.agg_restaurant_performance_daily\n",
        "GROUP BY\n",
        "  restaurant_name\n",
        "UNION ALL\n",
        "SELECT\n",
        "  restaurant_name,\n",
        "  'Takeaway',\n",
        "  SUM(takeaway_orders)\n",
        "FROM\n",
        "  restaurant_chain_db.marts.agg_restaurant_performance_daily\n",
        "GROUP BY\n",
        "  restaurant_name\n",
        "UNION ALL\n",
        "SELECT\n",
        "  restaurant_name,\n",
        "  'Delivery',\n",
        "  SUM(delivery_orders)\n",
        "FROM\n",
        "  restaurant_chain_db.marts.agg_restaurant_performance_daily\n",
        "GROUP BY\n",
        "  restaurant_name"
      ]
    }
  ],
