    {
      "name": "channel_mix",
      "displayName": "Order Channel Mix",
      "queryLines": [
        "SELECT\n",
        "  channel,\n",
        "  SUM(order_count) as total_orders\n",
        "FROM\n",
        "  (\n",
        "    SELECT\n",
        "      'Dine-In' as channel,\n",
        "      dine_in_orders as order_count\n",
        "    FROM\n",
        "      restaurant_chain_db.marts.agg_restaurant_performance_daily\n",
        "    UNION ALL\n",
        "    SELECT\n",
        "      'Takeaway',\n",
        "      takeaway_orders\n",
        "    FROM\n",
        "      restaurant_chain_db.marts.agg_restaurant_performance_daily\n",
        "    UNION ALL\n",
        "    SELECT\n",
        "      'Delivery',\n",
        "      delivery_orders\n",
        "    FROM\n",
        "      restaurant_chain_db.marts.agg_restaurant_performance_daily\n",
        "  ) t\n",
        "GROUP BY\n",
        "  channel\n",
        "ORDER BY\n",
        "  total_orders DESC"
      ]
    },
    {
      "name": "payment_mix",
      "displayName": "Payment Method Mix",
      "queryLines": [
        "SELECT\n",
        "  payment_method,\n",
        "  SUM(order_count) as total_orders\n",
        "FROM\n",
        "  (\n",
        "    SELECT\n",
        "      'Card' as payment_method,\n",
        "      card_orders as order_count\n",
        "    FROM\n",
        "      restaurant_chain_db.marts.agg_restaurant_performance_daily\n",
        "    UNION ALL\n",
        "    SELECT\n",
        "      'Cash',\n",
        "      cash_orders\n",
        "    FROM\n",
        "      restaurant_chain_db.marts.agg_restaurant_performance_daily\n",
        "    UNION ALL\n",
        "    SELECT\n",
        "      'Wallet',\n",
        "      wallet_orders\n",
        "    FROM\n",
        "      restaurant_chain_db.marts.agg_restaurant_performance_daily\n",
        "  ) t\n",
        "GROUP BY\n",
        "  payment_method\n",
        "ORDER BY\n",
        "  total_orders DESC"
      ]
    }
  ],
