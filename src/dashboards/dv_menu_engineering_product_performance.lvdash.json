{
  "datasets": [
    {
      "name": "menu_mv",
      "displayName": "menu_engineering_metrics",
      "columns": [
        {
          "displayName": "Order Period",
          "description": "Year-Month period for trend analysis",
          "expression": "CONCAT(CAST(`order_year` AS STRING), '-', LPAD(CAST(`order_month` AS STRING), 2, '0'))"
        },
        {
          "displayName": "Dietary Type",
          "description": "Human-readable veg/non-veg label",
          "expression": "CASE WHEN `is_vegetarian` = true THEN 'Vegetarian' ELSE 'Non-Vegetarian' END"
        }
      ],
      "asset_name": "restaurant_chain_db.marts.menu_engineering_metrics"
    }
